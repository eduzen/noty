// Copy this file to Config/Google.local.xcconfig (gitignored) and fill in the values for a
// Desktop-type OAuth client from Google Cloud Console (APIs & Services > Credentials,
// Application type: Desktop app). Enable the Google Calendar API in the same project.
//
// Example values:
// GOOGLE_OAUTH_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
// GOOGLE_OAUTH_CLIENT_SECRET = GOCSPX-example
//
// Leave the client ID empty to keep Google Calendar disabled. Recordings keep timestamp names.

GOOGLE_OAUTH_CLIENT_ID =
GOOGLE_OAUTH_CLIENT_SECRET =
