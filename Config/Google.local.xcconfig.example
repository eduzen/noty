// Copy this file to Config/Google.local.xcconfig (gitignored) and fill in the values for an
// iOS-type OAuth client from Google Cloud Console (APIs & Services > Credentials).
// The client must use the bundle ID com.eduzen.noty.
//
// Example values:
// GOOGLE_OAUTH_CLIENT_ID = 1234567890-abcdef.apps.googleusercontent.com
// GOOGLE_OAUTH_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdef
//
// Leave both empty to keep Google Calendar disabled. Recordings keep timestamp names.

GOOGLE_OAUTH_CLIENT_ID =
GOOGLE_OAUTH_REVERSED_CLIENT_ID =
